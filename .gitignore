!/uploads/parts/*.webp
!/uploads/parts/*.png

# Runtime logs (e.g. logs/mail.log from the password-reset flow).
/logs/*
!/logs/.gitkeep

# Deployment DB dump — contains real data, never commit
/database/deploy_dump.sql

